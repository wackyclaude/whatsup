{
  // Cloudflare Worker for the hosted dashboard.
  // Personal settings are NOT here: they are set in the Cloudflare dashboard
  // (GOOGLE_CLIENT_ID, and the secrets GOOGLE_CLIENT_SECRET, SESSION_SECRET,
  // WHATSUP_CONFIG). See docs/HOSTING.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsup",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Preview URLs would be a second address that Google sign-in would not accept: keep them off.
  "preview_urls": false,
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    // Run the Worker (and its sign-in check) before serving ANY file.
    "run_worker_first": true,
    // Exact paths only: the Worker decides what "/" shows.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Keep variables set in the Cloudflare dashboard when redeploying.
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
